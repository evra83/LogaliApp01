 @Metadata.layer: #CORE
 @UI: {
    headerInfo:{
        typeName: 'Travel',
        typeNamePlural: 'Travels'
    },
    presentationVariant: [ {  
         sortOrder:[{ by: 'TravelId', direction: #DESC}],
         visualizations: [{ type: #AS_LINEITEM }]
        }
    ]    
         
 }
annotate entity ZC_TRAVEL_EV
    with 
{
    @EndUserText.label: 'Travel UUID'
    @UI.hidden: true
    Traveluuid;
    @EndUserText.label: 'Travel ID'
    @UI:{ 
        lineItem: [{ position: 10 }],
        selectionField: [{ position: 10 }] 
    }
    TravelId;
    @EndUserText.label: 'Agency ID'
    @UI:{ 
        lineItem: [{ position: 20 }] ,
        textArrangement: #TEXT_ONLY,
        selectionField: [{ position: 20 }]
     }
    AgencyId;
    @EndUserText.label: 'Customer'
    @UI:{ 
        lineItem: [{ position: 30 }],
        textArrangement: #TEXT_ONLY,
        selectionField: [{ position: 30 }] 
    }
    CustomerId;
    @EndUserText.label: 'Begin Date'
    @UI:{ lineItem: [{ position: 40 }] }
    BeginDate;
    @EndUserText.label: 'End Date'
    @UI:{ lineItem: [{ position: 50 }] }
    EndDate;
    @EndUserText.label: 'Currency'
    @UI:{ lineItem: [{ position: 60 }] }
    CurrencyCode;
    @EndUserText.label: 'Booking Fee'
    @UI:{ lineItem: [{ position: 70 }] }
    BookingFee;
    @EndUserText.label: 'Total Price'
    @UI:{ lineItem: [{ position: 80 }] }
    TotalPrice;
    @EndUserText.label: 'Description'
    @UI:{ lineItem: [{ position: 90 }] }
    Description;
    @EndUserText.label: 'Overall Status'
    @UI:{ 
        lineItem: [{ 
            position: 100,
            cssDefault.width: '10rem',
            criticality: 'OverallStatusCriticality' 
        }],
        textArrangement: #TEXT_ONLY,
        selectionField: [{ position: 40 }] 
    }
    OverallStatus;
    @EndUserText.label: 'Local Created By'
    @UI.hidden: true
    LocalCreatedBy;
    @EndUserText.label: 'Local Created At'
    @UI.hidden: true
    LocalCreatedAt;
    @EndUserText.label: 'Local Last Changed By'
    @UI.hidden: true
    LocalLastChangedBy;
    @EndUserText.label: 'Local Last Changed At'
    @UI.hidden: true
    LocalLastChangedAt;
    @EndUserText.label: 'Last Changed At'
    @UI.hidden: true
    LastChangedAt;

    
}