@Metadata.layer: #CORE
@UI: {
    headerInfo: {
        typeName: 'Booking',
        typeNamePlural: 'Bookings',
        title: {
            value: 'BookingId'
        },
        description: {
            value: 'CustomerID'
        }
    },
    presentationVariant: [
        {
            sortOrder: [{ by: 'BookingId', direction: #DESC }],
            visualizations: [ { type: #AS_LINEITEM } ]
        }
    ]
}
annotate entity ZC_BOOKING_EV
    with 
{
 @UI.facet: [
        {
            id: 'GeneralSection',
            purpose: #STANDARD,
            type: #COLLECTION,
            label: 'General Information',
            position: 10
        },
        {
            id: 'Booking',
            purpose: #STANDARD,
            type: #FIELDGROUP_REFERENCE,
            label: 'Booking',
            parentId: 'GeneralSection',
            targetQualifier: 'Booking',
            position: 10
        },
        {
            id: 'FlightDetails',
            purpose: #STANDARD,
            type: #FIELDGROUP_REFERENCE,
            label: 'Flight Details',
            parentId: 'GeneralSection',
            targetQualifier: 'FlightDetails',
            position: 20
        },
        {
            id: 'Pricing',
            purpose: #STANDARD,
            type: #FIELDGROUP_REFERENCE,
            label: 'Pricing',
            parentId: 'GeneralSection',
            targetQualifier: 'Pricing',
            position: 30
        },
        {
            id: 'Supplements',
            purpose: #STANDARD,
            type: #LINEITEM_REFERENCE,
            label: 'Supplements',
            position: 40,
            targetElement: '_bookingsuppl'
        }
    ]
    
    @EndUserText.label: 'Booking UUID'
    @UI.hidden: true
    Bookinguuid;
    
    @EndUserText.label: 'Travel UUID'
    @UI.hidden: true
    travelUuid;
    
    @EndUserText.label: 'Booking ID'
    @UI: {
        lineItem: [ { position: 10 } ],
        selectionField: [ { position: 10 } ],
        fieldGroup: [ { position: 10, qualifier: 'Booking' } ]
    }
    BookingId;
    
    @EndUserText.label: 'Booking Date'
    @UI: {
        lineItem: [ { position: 20 } ],
        fieldGroup: [ { position: 20, qualifier: 'Booking' } ]
    }
    BookingDate;
    
     @EndUserText.label: 'Customer ID'
    @UI: {
        lineItem: [ { position: 30 } ],
        selectionField: [ { position: 20 } ],
        fieldGroup: [ { position: 10, qualifier: 'FlightDetails' } ]
    }
    CustomerId;
    
    @EndUserText.label: 'Airline ID'
    @UI: {
        lineItem: [ { position: 40 } ],
        selectionField: [ { position: 30 } ],
        fieldGroup: [ { position: 20, qualifier: 'FlightDetails' } ]
    }
    AirlaneId;
    
    @EndUserText.label: 'Connection ID'
    @UI: {
        lineItem: [ { position: 50 } ],
        fieldGroup: [ { position: 30, qualifier: 'FlightDetails' } ]
    }
    ConnectionId;
    
    @EndUserText.label: 'Flight Date'
    @UI: {
        lineItem: [ { position: 60 } ],
        fieldGroup: [ { position: 40, qualifier: 'FlightDetails' } ]
    }
    FlightDate;
    
    @EndUserText.label: 'Currency Code'
    @UI: {
        fieldGroup: [ { position: 10, qualifier: 'Pricing' } ]
    }
    CurrencyCode;
    
    @EndUserText.label: 'Flight Price'
    @UI: {
        lineItem: [ { position: 70 } ],
        fieldGroup: [ { position: 20, qualifier: 'Pricing' } ]
    }
    FlightPrice;
    
    @EndUserText.label: 'Booking Status'
    @UI: {
        lineItem: [ { position: 80 } ],
        selectionField: [ { position: 40 } ],
        fieldGroup: [ { position: 30, qualifier: 'Booking' } ]
    }
    BookingStatus;
    
    @EndUserText.label: 'Last Changed At'
    @UI.hidden: true
    LocalLastChangedAt;
}