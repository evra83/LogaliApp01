managed;
strict ( 2 );                                           //Validación de Sintaxis estricta
with draft;

define behavior for ZI_TRAVEL_EV alias Travel
implementation in class zbp_i_travel_ev unique          //Establecer Clase para comportamiento de la interfaz de negocio
persistent table ztravel_ev                             //tabla donde almacenar registros
draft table ztravel_ev_d                                //tabla draft
lock master total etag LocalLastChangedAt               //Bloqueo de registros para evitar conflictos de actualización
authorization master ( instance )                       //
etag master LocalLastChangedAt                          //Toma el campo con la ultima fecha y bloquea el objetp
{
  create ( authorization : global );
  update;
  delete;

  field ( readonly, numbering : managed ) Traveluuid;   //Autonumerico
  field ( readonly ) Travelid,                          //Campos de solo lectura
  LocalCreatedAt,
  LocalCreatedBy,
  LocalLastChangedAt,
  LocalLastChangedBy,
  //OverallStatus,
  //OverallStatusCriticality,
  CustomerName;

  field ( mandatory ) AgencyId, CustomerId, BeginDate, EndDate, CurrencyCode, BookingFee, TotalPrice;  //Campos obligatorios para crear un registro

  draft action Resume;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;

  determination setTravelnumber on save { create; }
  determination setInitialDefault on modify { create; }

  validation validateAgency on save { create; update; field AgencyId; }
  determine action validateAgencyID { validation validateAgency; }

  validation validateCostumer on save { create; update; field CustomerId; }
  determine action validateCostumerID { validation validateCostumer; }

  validation validateDates on save { create; update; field BeginDate, EndDate; }
  determine action validateDateRange { validation validateDates; }

  validation validateBookingFee on save { create; update; field BookingFee; }
  determine action validateBookingFeeValue { validation validateBookingFee; }


  //Validaciones de draft
  draft determine action Prepare{
    validation ( always ) validateAgency;
    validation ( always ) validateCostumer;
    validation ( always ) validateDates;
    validation ( always ) validateBookingFee;
  }

  side effects
  {
    determine action validateAgencyID executed on field AgencyId affects messages;
    determine action validateCostumerID executed on field CustomerId affects messages;
    determine action validateDateRange executed on field BeginDate, field EndDate affects messages;
  }


  association _booking { create; with draft; }                      //Asociación con la tabla de Booking para Navegación - Solo se hace en el padre

  mapping for ztravel_ev
    {
      Traveluuid         = travel_uuid;
      Travelid           = travel_id;
      AgencyId           = agency_id;
      CustomerId         = customer_id;
      BeginDate          = begin_date;
      EndDate            = end_date;
      CurrencyCode       = currency_code;
      Bookingfee         = booking_fee;
      TotalPrice         = total_price;
      Description        = description;
      overallstatus      = overall_status;
      localcreatedby     = Local_Created_By;
      localcreatedat     = Local_Created_At;
      locallastchangedby = Local_Last_Changed_By;
      locallastchangedat = Local_Last_Changed_at;
      lastchangedat      = last_changed_at;
    }
}

define behavior for ZI_BOOKING_EV alias Booking
implementation in class zbp_i_booking_ev unique
persistent table zbooking_ev
draft table zbooking_ev_d
lock dependent by _travel
authorization dependent by _travel
etag master LocalLastChangedAt
{
  update;
  delete;
  field ( readonly, numbering : managed ) Bookinguuid;
  field ( readonly ) travelUuid,
  Bookingid,
  LocalLastChangedAt;
  association _travel { with draft; }
  association _bookingsuppl { create; with draft; }

  mapping for zbooking_ev
    {
      Bookinguuid        = booking_uuid;
      Traveluuid         = parent_uuid;
      Bookingid          = booking_id;
      BookingDate        = booking_date;
      CustomerId         = customer_id;
      AirlaneId          = carrier_id;
      ConnectionId       = connection_id;
      FlightDate         = flight_date;
      CurrencyCode       = currency_code;
      FlightPrice        = flight_price;
      BookingStatus      = booking_status;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for ZI_BSUPPL_EV alias BookingSupplement
implementation in class zbp_i_BSUPPL_ev unique
persistent table zbsuppl_ev
draft table zbsuppl_ev_d
lock dependent by _travel
authorization dependent by _travel
etag master LocalLastChangedAt
{
  update;
  delete;

  field ( readonly, numbering : managed ) BookingsupplUuid;
  field ( readonly ) TravelUuid,
  Bookinguuid,
  localLastChangedAt;

  association _travel { with draft; }
  association _booking { with draft; }

  mapping for zbsuppl_ev
    {
      BookingsupplUuid   = bookingsuppl_uuid;
      TravelUuid         = root_uuid;
      BookingUuid        = parent_uuid;
      BookingSupplemetId = booking_supplemet_id;
      SupplementId       = supplemet_id;
      CurrencyCode       = currency_code;
      Price              = price;
      LocalLastChangedAt = local_last_changed_at;
    }

}